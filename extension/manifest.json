{
  "manifest_version": 3,
  "name": "Anchor",
  "version": "1.0.0",
  "description": "A personal focus and discipline companion.",

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs"
  ],

  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.facebook.com/*",
    "*://*.tiktok.com/*",
    "*://*.google.com/*",
    "*://*.bing.com/*",
    "*://*.duckduckgo.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.facebook.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": ["shared/content.js", "content-scripts/feed-neutralizer.js"],
      "css": ["content-scripts/feed-neutralizer.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.bing.com/search*",
        "*://duckduckgo.com/*"
      ],
      "js": ["shared/content.js", "content-scripts/trigger-interceptor.js"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "options/options.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "declarative_net_request": {
    "rule_resources": []
  }
}
